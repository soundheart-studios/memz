{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amx.dev/schema/0.1/record.schema.json",
  "title": "AMX memory record",
  "type": "object",
  "required": ["amx", "id", "revision", "kind", "content", "scope", "provenance", "status", "valid_from", "recorded_at"],
  "properties": {
    "amx": { "const": "0.1" },
    "id": { "$ref": "#/$defs/id" },
    "revision": { "$ref": "#/$defs/revision" },
    "kind": { "type": "string", "pattern": "^(fact|preference|decision|procedure|task|incident|entity|secret_ref|[a-z][a-z0-9_]*\\.[A-Za-z0-9_.-]+)$" },
    "content": { "type": "string" },
    "content_type": { "enum": ["text/plain", "text/markdown"] },
    "key": { "type": "string", "minLength": 1, "maxLength": 256 },
    "scope": { "$ref": "#/$defs/scope" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "status": { "enum": ["active", "superseded", "invalid"] },
    "supersedes": { "$ref": "#/$defs/ref" },
    "valid_from": { "$ref": "#/$defs/timestamp" },
    "valid_to": { "$ref": "#/$defs/timestamp" },
    "recorded_at": { "$ref": "#/$defs/timestamp" },
    "event_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "attributes": { "$ref": "#/$defs/attributes" }
  },
  "allOf": [
    {
      "if": { "properties": { "provenance": { "properties": { "explicit": { "const": false } } } } },
      "then": { "required": ["evidence"], "properties": { "evidence": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "ref": {
      "type": "object",
      "required": ["id", "revision"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/revision" } }
    },
    "attributes": { "type": "object", "propertyNames": { "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_.-]+$", "not": { "pattern": "^secret\\.value" } } },
    "scope": {
      "type": "object",
      "required": ["namespace", "visibility"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "visibility": { "enum": ["project", "session", "personal"] },
        "session": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "user": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": { "type": "string" },
      "allOf": [
        { "if": { "properties": { "visibility": { "const": "session" } } }, "then": { "required": ["session"] } },
        { "if": { "required": ["branch"] }, "then": { "required": ["repo"] } }
      ]
    },
    "provenance": {
      "type": "object",
      "required": ["origin", "author", "explicit"],
      "properties": {
        "origin": { "enum": ["user", "agent", "extractor", "import", "system"] },
        "author": { "type": "string", "minLength": 1 },
        "explicit": { "type": "boolean" },
        "method": { "type": "string", "minLength": 1 },
        "method_version": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "explicit": { "const": false } } },
      "then": { "required": ["method", "method_version"] }
    },
    "evidence": {
      "type": "object",
      "required": ["source", "source_revision", "role"],
      "properties": {
        "source": { "$ref": "#/$defs/id" },
        "source_revision": { "$ref": "#/$defs/revision" },
        "span": { "type": "array", "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }], "minItems": 2, "maxItems": 2 },
        "role": { "enum": ["supports", "contradicts", "context"] }
      }
    }
  }
}
